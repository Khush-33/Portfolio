// ============================================================
// firestore.rules
//
// Anyone can READ these three collections (that's how the
// public site displays your projects/certs/publications).
// Only YOU can WRITE to them — enforced by checking the
// signed-in user's UID against your admin UID below.
//
// SETUP:
// 1. Create your admin user in Firebase Console →
//    Authentication → Users → Add user (email + password).
// 2. Copy that user's UID from the Users table.
// 3. Replace YOUR_ADMIN_UID_HERE below with that UID.
// 4. Deploy these rules — either paste this file's contents
//    into Firebase Console → Firestore Database → Rules → Publish,
//    or if you use the Firebase CLI:
//      firebase deploy --only firestore:rules
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "YOUR_ADMIN_UID_HERE";
    }

    match /certifications/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "YOUR_ADMIN_UID_HERE";
    }

    match /publications/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "YOUR_ADMIN_UID_HERE";
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
